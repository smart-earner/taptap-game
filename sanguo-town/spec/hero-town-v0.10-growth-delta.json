  "happiness": {
    "scope": "per_resident_hero",
    "range": [
      0,
      100
    ],
    "initial_value": 70,
    "new_resident_initial_value": "clamp(city_average,50,80)",
    "waiting_hero_updates": false,
    "city_happiness": "roundHalfUp(sum(resident_happiness)/resident_count)",
    "dimensions": [
      {
        "id": "food_coverage",
        "symbol": "C",
        "weight_bp": 3000,
        "formula": "last_4_closed_meals_served_mU/expected_mU*100"
      },
      {
        "id": "meal_quality",
        "symbol": "Q",
        "weight_bp": 500,
        "formula": "last_4_closed_meals_actual_quality_weighted_average"
      },
      {
        "id": "housing",
        "symbol": "H",
        "weight_bp": 1500,
        "formula": "formal_household_unit_and_person_capacity=100;guest_bed=70;no_legal_residence=0"
      },
      {
        "id": "rest",
        "symbol": "R",
        "weight_bp": 1500,
        "formula": "clamp(previous_cycle_continuous_night_rest_s/600*100,0,100)"
      },
      {
        "id": "environment",
        "symbol": "D",
        "weight_bp": 1000,
        "formula": "city_environment_score_from_S05"
      },
      {
        "id": "security",
        "symbol": "S",
        "weight_bp": 1000,
        "formula": "city_security_score_from_S05"
      },
      {
        "id": "workload_balance",
        "symbol": "W",
        "weight_bp": 1500,
        "formula": "clamp(100-roundHalfUp(max(0,previous_cycle_duty_s-1440)*60/480),0,100)",
        "duty_includes": [
          "labor",
          "travel",
          "loading",
          "unloading",
          "job_switch"
        ],
        "idle_without_eligible_demand_is_not_penalized": true
      }
    ],
    "target_formula": "roundHalfUp((3000C+500Q+1500H+1500R+1000D+1000S+1500W)/10000)",
    "update_at": "each_meal_window_close",
    "rise_limit_per_update": 3,
    "fall_limit_by_meal_coverage_tier": {
      "9500_to_10000": 5,
      "8000_to_9499": 8,
      "6000_to_7999": 12,
      "0_to_5999": 15
    },
    "work_rate_modifier_bp": [
      {
        "min": 85,
        "max": 100,
        "value": 500
      },
      {
        "min": 70,
        "max": 84,
        "value": 0
      },
      {
        "min": 50,
        "max": 69,
        "value": -500
      },
      {
        "min": 30,
        "max": 49,
        "value": -1000
      },
      {
        "min": 0,
        "max": 29,
        "value": -1500
      }
    ],
    "modifier_snapshot_at": "task_stage_start",
    "negative_modifier_floor_bp_for_recovery_jobs": 0,
    "recovery_jobs": [
      "farmer",
      "cook",
      "server",
      "porter_carrying_food",
      "emergency_food_equipment_repair",
      "already_loaded_cargo_delivery"
