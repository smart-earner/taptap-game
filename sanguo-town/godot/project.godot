; Independent Godot 4.7 visual slice; existing Swift simulation is the authority.
config_version=5

[application]
config/name="小城志 · 桌面大地图"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Godot 3D presentation + the existing Swift town simulation. Independent save."

[display]
window/per_pixel_transparency/allowed=true
window/subwindows/embed_subwindows=false
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1920
window/size/window_height_override=1200
window/stretch/mode="canvas_items"
window/size/min_width=1100
window/size/min_height=720

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
environment/defaults/default_clear_color=Color(0.87, 0.89, 0.82, 1)

[debug]
gdscript/warnings/untyped_declaration=0

[physics]
common/physics_ticks_per_second=30
